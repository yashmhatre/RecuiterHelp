# Copy to .env and fill in. .env is gitignored and must never be committed.
# Settings (thresholds, prompts) live in config/settings.yaml, not here. This file is secrets
# and per-machine locations only.

# ---------- mailbox ----------
# Which provider this deployment tracks: gmail | outlook
EA_PROVIDER=
# The single mailbox address being watched (requirement 8: one mailbox).
EA_MAILBOX_ADDRESS=

# ---------- Gmail OAuth (P0-05) ----------
# Scopes are read + compose + labels only. Never gmail.send.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_FILE=.secrets/gmail_token.json

# ---------- Microsoft Graph OAuth (P0-05) ----------
# App registration must have Mail.ReadWrite only. Never Mail.Send.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_TOKEN_FILE=.secrets/graph_token.json

# ---------- PostgreSQL (P0-03) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_agent
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ---------- Ollama (P0-02) ----------
OLLAMA_HOST=http://localhost:11434
OLLAMA_CLASSIFY_MODEL=qwen3:8b
OLLAMA_DRAFT_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---------- MLflow (P0-04) ----------
# Leave empty to disable tracing entirely. Tracing never fails the pipeline.
MLFLOW_TRACKING_URI=http://localhost:5000

# ---------- local paths ----------
# Resume files. Gitignored; never committed.
EA_RESUME_DIR=resumes
